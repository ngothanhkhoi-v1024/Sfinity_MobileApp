# =============================================================================
# Cấu hình API — Sfinity Mobile
# -----------------------------------------------------------------------------
# Sau khi clone: chỉnh ĐÚNG MỘT giá trị API_BASE_URL phù hợp cách bạn chạy app.
# Bật một dòng (bỏ #), các phương án khác giữ nguyên dấu #.
#
# Backend mặc định trong repo: cổng 3000 (xem backend/).
# -----------------------------------------------------------------------------

# --- Flutter Web / Chrome ---
# Backend chạy trên cùng máy với trình duyệt.
#API_BASE_URL=http://localhost:3000/api

# --- Android Emulator (mặc định sau khi clone) ---
# 10.0.2.2 = localhost của máy host (Windows/Mac/Linux) nhìn từ emulator.
#API_BASE_URL=http://10.0.2.2:3000/api

# --- iOS Simulator ---
# Thường dùng localhost của máy Mac host.
#API_BASE_URL=http://127.0.0.1:3000/api

# --- Thiết bị thật (Android/iOS) hoặc máy khác trong LAN ---
# Thay YOUR_LAN_IP bằng IP máy đang chạy backend (vd: ipconfig trên Windows).
# Đảm bảo điện thoại và máy dev cùng mạng Wi‑Fi / LAN.
# API_BASE_URL=http://YOUR_LAN_IP:3000/api

#URL API chính thức (điền URL backend của bạn vào đây, vd: http://
API_BASE_URL=https://sfinity-backend-947472672630.asia-southeast1.run.app/api

# Timeout HTTP (giây)
API_TIMEOUT_SECONDS=30

# =============================================================================
# Cấu hình Deep Link — MoMo Payment Callback
# -----------------------------------------------------------------------------
# URL scheme dùng để MoMo (hoặc trình duyệt) mở lại app Sfinity sau khi thanh toán.
# Mặc định dùng custom scheme `sfinity://`. Giá trị này phải khớp với
# cấu hình trong AndroidManifest.xml (intent-filter data scheme) và Info.plist
# (CFBundleURLSchemes).
# Đổi scheme ở đây nếu bạn muốn dùng tên khác (vd: sfinityvip, sfapp, ...).
MOMO_RETURN_SCHEME=sfinity

# =============================================================================
# Cấu hình Backend cho MoMo IPN
# -----------------------------------------------------------------------------
# Khi backend deploy lên production (hoặc dùng ngrok để test local), điền URL
# đầy đủ của endpoint IPN để MoMo gọi server-to-server khi thanh toán xong.
# Ví dụ local: https://abc123.ngrok.io/api/payments/momo/ipn
# Ví dụ production: https://your-backend.com/api/payments/momo/ipn
# MOMO_IPN_URL=https://your-ngrok-or-domain.com/api/payments/momo/ipn
