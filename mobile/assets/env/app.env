# =============================================================================
# Cấu hình API — Sfinity Mobile
# -----------------------------------------------------------------------------
# Sau khi clone: chỉnh ĐÚNG MỘT giá trị API_BASE_URL phù hợp cách bạn chạy app.
# Bật một dòng (bỏ #), các phương án khác giữ nguyên dấu #.
#
# Backend mặc định trong repo: cổng 3000 (xem backend/).
# =============================================================================

# --- Flutter Web / Chrome ---
# Backend chạy trên cùng máy với trình duyệt.
#API_BASE_URL=http://localhost:3000/api

# --- Android Emulator ---
#10.0.2.2 = localhost của máy host (Windows/Mac/Linux) nhìn từ emulator.
API_BASE_URL=http://10.0.2.2:3000/api

# --- iOS Simulator ---
# Thường dùng localhost của máy Mac host.
#API_BASE_URL=http://127.0.0.1:3000/api

# --- Thiết bị thật (Android/iOS) hoặc máy khác trong LAN ---
# Thay YOUR_LAN_IP bằng IP máy đang chạy backend (vd: ipconfig trên Windows).
# Đảm bảo điện thoại và máy dev cùng mạng Wi‑Fi / LAN.
# API_BASE_URL=http://YOUR_LAN_IP:3000/api

#URL API chính thức (điền URL backend của bạn vào đây, vd: http://
#API_BASE_URL=https://sfinity-backend-947472672630.asia-southeast1.run.app/api
# Timeout HTTP (giây)
API_TIMEOUT_SECONDS=30
