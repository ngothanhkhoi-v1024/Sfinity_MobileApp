# URL backend API
# Chạy local: dùng dòng dưới (backend mặc định cổng 3000)
VITE_API_BASE_URL=http://localhost:3000/api

# Hoặc dùng backend đã deploy (không cần chạy backend local):
# VITE_API_BASE_URL=https://sfinity-backend-947472672630.asia-southeast1.run.app/api

# Bật mock auth khi backend chưa sẵn sàng (chỉ để dev UI)
VITE_USE_MOCK_AUTH=false
