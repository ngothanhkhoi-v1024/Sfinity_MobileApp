# -----------------------------------------------------------------------------
# SFINITY BACKEND - HỒ SƠ BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Hãy sao chép tệp này thành .env và điền các giá trị thực tế của bạn.
# -----------------------------------------------------------------------------

# Cổng khởi chạy Server của Backend (mặc định: 3000)
PORT=3000

# Base URL của Backend API (dùng để tạo liên kết xác thực trong email)
API_BASE_URL=http://localhost:3000

# Chuỗi bí mật JWT dùng để mã hóa và ký Access Token đăng nhập
JWT_SECRET=change-me-in-production-use-a-very-long-random-string

# Thời gian hết hạn của JWT Access Token (Ví dụ: 7 ngày = 7d, 2 giờ = 2h)
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# CẤU HÌNH CƠ SỞ DỮ LIỆU (DATABASE CONFIGURATION)
# -----------------------------------------------------------------------------
# Đường dẫn kết nối Prisma Client (Mặc định dùng SQLite cục bộ dev.db)
DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------------------
# CẤU HÌNH HỆ THỐNG GỬI EMAIL (SMTP MAIL SERVER CONFIGURATION)
# -----------------------------------------------------------------------------
# Nếu KHÔNG điền các thông tin SMTP bên dưới:
# Backend sẽ tự động kích hoạt tài khoản kiểm thử Ethereal Mail miễn phí 
# và in liên kết xem thử email (Preview URL) ra màn hình Terminal khi gửi OTP.
#
# Nếu muốn dùng email thật (Ví dụ: Gmail SMTP), hãy điền các thông tin sau:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
# Lưu ý đối với Gmail: Cần tạo và điền "Mật khẩu ứng dụng" (App Password) thay vì mật khẩu chính.
SMTP_PASS=your-app-password
SMTP_FROM="Sfinity <no-reply@sfinity.com>"

# -----------------------------------------------------------------------------
# CẤU HÌNH FIREBASE ADMIN SDK (Yêu cầu cho đăng nhập MXH và xác thực Email)
# -----------------------------------------------------------------------------
# Lấy các thông tin này từ file JSON Private Key khi tạo Service Account trên Firebase Console:
# Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key.

FIREBASE_PROJECT_ID=mobile-e1ac5
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@mobile-e1ac5.iam.gserviceaccount.com

# Lưu ý đối với Private Key: Phải bao gồm đầy đủ cả chuỗi bắt đầu -----BEGIN PRIVATE KEY-----
# và kết thúc -----END PRIVATE KEY-----\n. Dùng ký tự xuống dòng \n nếu viết trên một dòng.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkqhkiG9w0BAQEFAASCBKYwgg...==\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# TRỢ LÝ AI HẢI CẨU & KIỂM DUYỆT (ASSISTANT & MODERATION)
# -----------------------------------------------------------------------------
# Nếu KHÔNG điền OPENAI_API_KEY, backend dùng FAQ tĩnh (vẫn hoạt động offline dev).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (Miễn phí 100% trên Google AI Studio, tối ưu cho kiểm duyệt tiếng Việt)
# GEMINI_API_KEY=AIzaSy...

# -----------------------------------------------------------------------------
# CẤU HÌNH CỔNG THANH TOÁN MOMO (MOMO PAYMENT GATEWAY)
# -----------------------------------------------------------------------------
# Lấy các thông tin này từ MoMo Business Portal: https://business.momo.vn/
# Khi đăng ký, MoMo sẽ cấp partnerCode / accessKey / secretKey cho 2 môi trường:
#   - Sandbox (test):  https://test-payment.momo.vn
#   - Production:      https://payment.momo.vn
#
# Mặc định bên dưới dùng sandbox/test. Khi lên production hãy thay các giá trị
# MOMO_ACCESS_KEY, MOMO_SECRET_KEY, MOMO_PARTNER_CODE, MOMO_BASE_URL tương ứng
# và đặt MOMO_ENV=production.

MOMO_ENV=sandbox
MOMO_PARTNER_CODE=MOMO_PARTNER_CODE
MOMO_ACCESS_KEY=MOMO_ACCESS_KEY
MOMO_SECRET_KEY=MOMO_SECRET_KEY
MOMO_BASE_URL=https://test-payment.momo.vn

# URL MoMo sẽ redirect người dùng về sau khi thanh toán (mở app qua deep link).
# Mặc định dùng scheme sfinity://payment-callback. Khi build production nên
# thay bằng URL https thật (vd: https://sfinity.app/payment/callback) để MoMo
# cho phép trên hệ thống của họ.
MOMO_REDIRECT_URL=sfinity://payment-callback

# IPN (Instant Payment Notification): MoMo server-to-server gọi endpoint này
# để xác nhận kết quả thanh toán. Phải là URL backend có thể truy cập từ
# internet (vd: https://your-backend.com/api/payments/momo/ipn).
# Khi dev local có thể dùng ngrok / localtunnel để expose.
# MOMO_IPN_URL=https://your-backend.com/api/payments/momo/ipn

# -----------------------------------------------------------------------------
# CẤU HÌNH CỔNG THANH TOÁN VNPAY (VNPAY PAYMENT GATEWAY)
# -----------------------------------------------------------------------------
# Lấy các thông tin này từ VNPay Merchant Portal: https://merchant.vnpayment.vn/
# Khi đăng ký, VNPay sẽ cấp tmnCode / hashSecret cho 2 môi trường:
#   - Sandbox (test): https://sandbox.vnpayment.vn/apis/paymentv2/vpcpay.html
#   - Production:     https://pay.vnpayment.vn/apis/paymentv2/vpcpay.html
#
# Mặc định bên dưới dùng sandbox/test. Khi lên production hãy thay các giá trị
# VNPAY_URL, VNPAY_API_URL tương ứng và bỏ comment các dòng production.

# Mã định danh Merchant (Terminal ID) - được cấp khi đăng ký
VNPAY_TMN_CODE=YOUR_TMN_CODE

# Chuỗi bí mật để tạo và xác minh chữ ký SHA512
VNPAY_HASH_SECRET=YOUR_HASH_SECRET

# URL thanh toán VNPay (dùng sandbox mặc định)
VNPAY_URL=https://sandbox.vnpayment.vn/apis/paymentv2/vpcpay.html

# API URL để query transaction (dùng cho refund, query)
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# URL redirect người dùng sau khi thanh toán (mở app qua deep link)
VNPAY_RETURN_URL=sfinity://payment-vnpay-callback

# IPN URL: VNPay gọi endpoint này để xác nhận thanh toán server-to-server
# Phải là URL backend có thể truy cập từ internet
# VNPAY_IPN_URL=https://your-backend.com/api/payments/vnpay/ipn
