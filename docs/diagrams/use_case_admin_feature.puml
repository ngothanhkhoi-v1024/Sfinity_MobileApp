@startuml UC_Admin
skinparam {
    dpi 100
    nodesep 20
    ranksep 25
}

title UC - Quản trị (Admin)

left to right direction

actor "Admin" as Admin

rectangle "Quản trị" {
    usecase "Xem Dashboard thống kê" as Dashboard
    usecase "Quản lý người dùng" as ManageUsers
    usecase "Duyệt tài liệu" as ApproveDoc
    usecase "Ẩn / Xóa tài liệu" as ModDoc
    usecase "Xử lý báo cáo vi phạm" as HandleReport
    usecase "Quản lý danh mục" as ManageCats
    usecase "Quản lý tiện ích địa điểm" as ManageAmenities
    usecase "Gửi thông báo hệ thống" as SendNotif
}

Admin --> Dashboard
Admin --> ManageUsers
Admin --> ApproveDoc
Admin --> ModDoc
Admin --> HandleReport
Admin --> ManageCats
Admin --> ManageAmenities
Admin --> SendNotif

@enduml
