@startuml Sfinity_Class_Diagram
!theme plain

title Sfinity — Class Diagram: Domain Model (Prisma Schema)

' ═══════════════════════════════════════════════════════════
' ENUMS
' ═══════════════════════════════════════════════════════════

package "Enums" {
  enum AuthProvider {
    LOCAL
    GOOGLE
    FACEBOOK
  }
  enum UserRole {
    USER
    ADMIN
  }
  enum UserStatus {
    ACTIVE
    BANNED
  }
  enum ContentStatus {
    DRAFT
    PENDING
    PUBLISHED
    REJECTED
    HIDDEN
  }
  enum ReportStatus {
    PENDING
    RESOLVED
    REJECTED
  }
  enum MembershipRole {
    OWNER
    ADMIN
    MEMBER
  }
  enum MembershipStatus {
    PENDING
    APPROVED
    REJECTED
  }
  enum FriendshipStatus {
    PENDING
    ACCEPTED
    BLOCKED
  }
}

' ═══════════════════════════════════════════════════════════
' MODELS
' ═══════════════════════════════════════════════════════════

package "Models" {

  class User {
    id: String (PK)
    email: String (unique)
    passwordHash: String?
    firebaseUid: String? (unique)
    name: String
    avatar: String?
    role: UserRole
    status: UserStatus
    authProvider: AuthProvider
    notificationsEnabled: Boolean
    birthDate: DateTime?
    gender: String?
    address: String?
    createdAt: DateTime
    updatedAt: DateTime
    --
    + authenticate()
    + updateProfile()
    + changePassword()
  }

  class Content {
    id: String (PK)
    title: String
    body: String?
    status: ContentStatus
    type: String (document | place)
    authorId: String (FK → User)
    categoryId: String? (FK → Category)
    fileUrl: String?
    fileType: String?
    fileSize: Int?
    subjectCode: String?
    tags: String[] (JSON)
    downloadsCount: Int
    latitude: Float?
    longitude: Float?
    address: String?
    zone: String?
    hiddenReason: String?
    createdAt: DateTime
    updatedAt: DateTime
    --
    + publish()
    + approve()
    + reject()
    + hide()
    + incrementDownload()
  }

  class Category {
    id: String (PK)
    name: String
    slug: String (unique)
    description: String?
    createdAt: DateTime
    updatedAt: DateTime
  }

  class Amenity {
    id: String (PK)
    name: String
    slug: String (unique)
    description: String?
  }

  class PlaceCheckIn {
    id: String (PK)
    userId: String (FK → User)
    contentId: String (FK → Content, type=place)
    note: String?
    createdAt: DateTime
  }

  class PlaceReview {
    id: String (PK)
    userId: String (FK → User)
    contentId: String (FK → Content, type=place)
    rating: Int
    comment: String?
    createdAt: DateTime
    updatedAt: DateTime
  }

  class PlacePhoto {
    id: String (PK)
    userId: String (FK → User)
    contentId: String (FK → Content, type=place)
    url: String
    createdAt: DateTime
  }

  class DocumentReview {
    id: String (PK)
    userId: String (FK → User)
    contentId: String (FK → Content, type=document)
    rating: Int
    comment: String?
    createdAt: DateTime
    updatedAt: DateTime
  }

  class Group {
    id: String (PK)
    name: String
    description: String?
    avatarUrl: String?
    isPublic: Boolean
    autoApprove: Boolean
    creatorId: String (FK → User)
    createdAt: DateTime
    updatedAt: DateTime
    --
    + addMember()
    + removeMember()
    + inviteMember()
  }

  class GroupMember {
    id: String (PK)
    groupId: String (FK → Group)
    userId: String (FK → User)
    role: MembershipRole
    status: MembershipStatus
    joinedAt: DateTime
  }

  class GroupInvitation {
    id: String (PK)
    groupId: String (FK → Group)
    inviterId: String (FK → User)
    inviteeId: String (FK → User)
    status: MembershipStatus
    createdAt: DateTime
  }

  class Friendship {
    id: String (PK)
    requesterId: String (FK → User)
    addresseeId: String (FK → User)
    status: FriendshipStatus
    createdAt: DateTime
    updatedAt: DateTime
  }

  class Favorite {
    id: String (PK)
    userId: String (FK → User)
    contentId: String (FK → Content)
    createdAt: DateTime
  }

  class Feedback {
    id: String (PK)
    userId: String (FK → User)
    message: String
    rating: Int?
    resolved: Boolean
    reply: String?
    repliedAt: DateTime?
    createdAt: DateTime
    updatedAt: DateTime
    --
    + reply()
    + resolve()
  }

  class Report {
    id: String (PK)
    userId: String (FK → User)
    targetType: String
    targetId: String
    reason: String
    description: String?
    status: ReportStatus
    resolution: String?
    resolvedAt: DateTime?
    createdAt: DateTime
    --
    + resolve()
  }

  class Notification {
    id: String (PK)
    userId: String (FK → User)
    title: String
    body: String?
    read: Boolean
    createdAt: DateTime
    --
    + markRead()
  }

  class Setting {
    id: String (PK)
    autoApproveDocuments: Boolean
    autoApprovePlaces: Boolean
    updatedAt: DateTime
  }
}

' ═══════════════════════════════════════════════════════════
' RELATIONSHIPS
' ═══════════════════════════════════════════════════════════

User "1" --> "*" Content : author
User "1" --> "*" Favorite : favorites
User "1" --> "*" Feedback : submits
User "1" --> "*" Report : reports
User "1" --> "*" Notification : receives
User "1" --> "*" PlaceCheckIn : checkIns
User "1" --> "*" PlaceReview : placeReviews
User "1" --> "*" PlacePhoto : placePhotos
User "1" --> "*" DocumentReview : docReviews
User "1" --> "*" Group : createdGroups
User "1" --> "*" GroupMember : memberships
User "1" --> "*" GroupInvitation : invitesSent
User "1" --> "*" GroupInvitation : invitesReceived
User "1" --> "*" Friendship : sentRequests
User "1" --> "*" Friendship : receivedRequests

Content "1" --> "0..1" Category : belongsTo
Content "1" --> "*" Favorite : has
Content "1" --> "*" PlaceCheckIn : has
Content "1" --> "*" PlaceReview : has
Content "1" --> "*" PlacePhoto : has
Content "1" --> "*" DocumentReview : has

Group "1" --> "*" GroupMember : members
Group "1" --> "*" GroupInvitation : invitations
Group "1" --> "1" User : creator

@enduml
