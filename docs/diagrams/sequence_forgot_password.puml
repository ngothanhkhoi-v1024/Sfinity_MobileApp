@startuml Sequence_Forgot_Password
title Sequence - Quên mật khẩu (OTP Reset)

actor "Người dùng" as User
participant "Flutter App" as App
participant "Express API" as API
participant "Firestore" as Firestore
participant "Nodemailer" as Email

User -> App : Nhập email để đặt lại mật khẩu
App -> API : POST /auth/forgot-password\n{ email }
API -> Firestore : Tìm user theo email
alt User không tồn tại
    Firestore --> API : null
    API --> App : 200 OK (không tiết lộ user tồn tại)
    App --> User : "Nếu email tồn tại, mã OTP đã được gửi"
else User tồn tại
    API -> API : Tạo mã OTP 6 chữ số
    API -> Firestore : Lưu vào collection\npassword_resets\n{ email, code, expiresAt, used: false }
    Firestore --> API : OTP saved
    API -> Email : Gửi email chứa mã OTP
    Email --> User : Email với mã OTP
    User -> App : Nhập mã OTP + mật khẩu mới
    App -> API : POST /auth/reset-password\n{ email, code, newPassword }
    API -> Firestore : Tìm OTP document
    alt OTP không tồn tại / đã dùng / hết hạn
        API --> App : 400 Bad Request
        App --> User : Thông báo lỗi OTP
    else OTP hợp lệ
        API -> Firestore : Cập nhật used: true
        API -> Firestore : Cập nhật user.passwordHash\n(bcrypt hash mới)
        Firestore --> API : Password updated
        API -> Firebase : Cập nhật password trong\nFirebase Auth (Admin SDK)
        Firebase --> API : Password updated
        API --> App : 200 OK
        App --> User : "Đặt lại mật khẩu thành công"
        User -> App : Đăng nhập với mật khẩu mới
    end
end

@enduml
